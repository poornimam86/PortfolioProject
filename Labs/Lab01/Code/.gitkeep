package com.portfolio.model;

public class User {

    private int userId;
    private String userName;
    private String email;

    // Default Constructor
    public User() {

    }

    // Parameterized Constructor
    public User(int userId, String userName, String email) {
        this.userId = userId;
        this.userName = userName;
        this.email = email;
    }

    // Getters and Setters

